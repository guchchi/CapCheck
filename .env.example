# CapCheck configuration example.
# Copy to .env and adjust. Never commit real secrets.

# Dev-only local fixture source. Set to 0 in any non-development environment.
CAPCHECK_DEV_MODE=1

# Where scan JSON artifacts are written (relative to the project root).
CAPCHECK_DATA_DIR=data

# LLM provider. Only the deterministic no-op provider ships today.
CAPCHECK_LLM_PROVIDER=null

# Optional: raises the unauthenticated GitHub API rate limit (60 req/hour/IP)
# when scanning public repositories. Sent only as a request header; never
# written to a scan artifact or a log.
CAPCHECK_GITHUB_TOKEN=

# Reserved for Milestone 3 (Gemma 4 integration). Not used yet.
GEMINI_API_KEY=
