# CapCheck configuration example.
# Copy to .env and adjust. Never commit real secrets.

# Dev-only local fixture source. Set to 0 in any non-development environment.
CAPCHECK_DEV_MODE=1

# Where scan JSON artifacts are written (relative to the project root).
CAPCHECK_DATA_DIR=data

# Milestone 3: Gemma 4 semantic analysis. Set to 'gemma' to enable; default is 'null'.
CAPCHECK_LLM_PROVIDER=null

# Server-side Google API key for Gemma 4. Never exposed to frontend.
GEMINI_API_KEY=

# Gemma model identifier (default: gemma-4-31b-it)
CAPCHECK_GEMMA_MODEL=gemma-4-31b-it

# Bounded timeouts and retries for model calls
CAPCHECK_LLM_TIMEOUT=10.0
CAPCHECK_LLM_RETRIES=2
