# CapCheck configuration example.
# Copy to .env and adjust. Never commit real secrets.

# Milestone 1 scans local fixtures only. This flag enables the dev-only
# fixture source. Set to 0 in any non-development environment.
CAPCHECK_DEV_MODE=1

# Where scan JSON artifacts are written (relative to the project root).
CAPCHECK_DATA_DIR=data

# LLM provider. Milestone 1 ships only the deterministic no-op provider.
CAPCHECK_LLM_PROVIDER=null

# Reserved for Milestone 3 (Gemma 4 integration). Not used yet.
GEMINI_API_KEY=
